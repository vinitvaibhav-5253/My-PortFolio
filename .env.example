# ==============================================================================
# CONTACT FORM CONFIGURATION
# ==============================================================================
# The contact form supports two free background email services, plus an automatic
# direct-email fallback (Gmail web / mailto) if no keys are configured.

# ------------------------------------------------------------------------------
# OPTION 1: Web3Forms (RECOMMENDED - Quickest & Easiest, 100% Free)
# ------------------------------------------------------------------------------
# 1. Visit: https://web3forms.com
# 2. Enter your email: vinitvaibhav5253@gmail.com
# 3. Check your email for your Access Key.
# 4. Paste your Access Key below:
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ------------------------------------------------------------------------------
# OPTION 2: EmailJS (Alternative)
# ------------------------------------------------------------------------------
# 1. Create an account at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) -> get Service ID
# 3. Create an Email Template -> get Template ID
#    (template parameters: {{from_name}}, {{from_email}}, {{message}})
# 4. Go to Account > Public Key -> get Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
